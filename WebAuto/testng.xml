<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="Suite">
 <groups>
            <run>
                <include name="home"/>
            </run>
        </groups>
 <listeners>
<listener class-name="Listener.ListenerPage"/>
</listeners>
    <test name="Tests">
      <parameter name="browser" value="chrome"/>
        <classes>        
              <class name="Tests.HomeTest"/>    
        </classes>
    </test>
     <test name="Tests">
      <parameter name="browser" value="chrome"/>
        <classes>        
              <class name="Tests.SearchTest"/>    
        </classes>
    </test>
     <test name="Tests">
      <parameter name="browser" value="chrome"/>
        <classes>        
              <class name="Tests.ProfileTest"/>    
        </classes>
    </test>
</suite>
